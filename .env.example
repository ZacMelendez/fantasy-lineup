# Your league ID, from the ESPN league URL:
# https://fantasy.espn.com/football/team?leagueId=123456&teamId=4
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
# Your team ID within the league (the teamId query param when viewing your team)
ESPN_TEAM_ID=

# Required for private leagues only. See README for how to grab these cookies.
ESPN_S2=
ESPN_SWID=

# Seconds to cache ESPN responses
CACHE_TTL_SECONDS=300

# Optional: enables the AI narrative layer. Leave blank to disable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini
